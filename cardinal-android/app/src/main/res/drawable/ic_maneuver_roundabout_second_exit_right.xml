<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="40dp"
    android:height="40dp"
    android:viewportWidth="40"
    android:viewportHeight="40">

    <!-- Outer circle -->
    <path
        android:fillColor="@android:color/transparent"
        android:strokeColor="@color/direction_icon_background_alpha"
        android:strokeWidth="1"
        android:pathData="
            M20,10
            a10,10 0 1,1 0,20
            a10,10 0 1,1 0,-20" />

    <!-- Inner circle -->
    <path
        android:fillColor="@android:color/transparent"
        android:strokeColor="@color/direction_icon_background_alpha"
        android:strokeWidth="1"
        android:pathData="
            M20,12
            a8,8 0 1,1 0,16
            a8,8 0 1,1 0,-16" />

    <!-- Half arc (RIGHT SIDE) -->
    <path
        android:fillColor="@android:color/transparent"
        android:strokeColor="@color/direction_icon_background"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:pathData="
        M20,29
        A9,9 0 1,0 20,11" />

    <!-- Exit vertical line -->
    <path
        android:fillColor="@android:color/transparent"
        android:strokeColor="@color/direction_icon_background"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:pathData="M20,30 L20,35" />

    <!-- Arrow head -->
    <path
        android:fillColor="@android:color/transparent"
        android:strokeColor="@color/direction_icon_background"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="
            M20,1
            L16,5

            M20,1
            L24,5" />

    <!-- Arrow shaft (lowered to touch circle) -->
    <path
        android:fillColor="@android:color/transparent"
        android:strokeColor="@color/direction_icon_background"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:pathData="M20,1 L20,10" />

</vector>